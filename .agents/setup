#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "Ensuring Corepack 0.36.0 is available..."
if ! command -v corepack >/dev/null 2>&1 || [[ "$(corepack --version)" != "0.36.0" ]]; then
  npm install --global --ignore-scripts corepack@0.36.0
fi
corepack enable

echo "Installing Yarn dependencies..."
yarn install --immutable
