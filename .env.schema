# Environment variables used by this app. This file is committed and holds no secret values.
#
# - Local: values come from .env.local (gitignored), encrypted with `yarn varlock encrypt --file .env.local`.
# - Vercel: values come from the project's environment variables (Neon integration secrets),
#   which take precedence over .env files.
#
# @defaultSensitive=true @defaultRequired=false
# @generateTsTypes(path=./env.d.ts)
# ---

# Neon pooled connection string, used by the app and by drizzle-kit migrations
# @required
DATABASE_URL=

# Neon direct (non-pooled) connection string
DATABASE_URL_UNPOOLED=

# Neon database host
PGHOST=

# Spotify API credentials for /api/now-playing and /api/top-tracks (not currently configured)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Twitter API key for lib/twitter.ts (not currently configured)
TWITTER_API_KEY=
