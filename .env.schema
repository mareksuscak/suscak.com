# Environment variables used by this app. This file is committed and holds no secret values.
#
# - Local: values come from .env.local (gitignored), encrypted with `yarn varlock encrypt --file .env.local`.
# - Vercel: values come from the project's environment variables, which take precedence over .env files.
#
# To add a variable: declare it below first (with a comment and decorators such as @required),
# then set it locally (`KEY=varlock(prompt)` in .env.local + `yarn varlock load`) and on Vercel
# (`vercel env add KEY production --sensitive`, same for preview).
#
# @defaultSensitive=true @defaultRequired=false
# @generateTsTypes(path=./env.d.ts)
# ---

# Canonical public URL of the site, used for metadata, robots.txt and the sitemap
# @sensitive=false @required @type=url
SITE_URL=https://www.suscak.com
