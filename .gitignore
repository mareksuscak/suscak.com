# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Yarn 2+
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
credentials*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.schema is committed, values are not)
.env*
!.env.schema

# vercel
.vercel

# Amp orb portals
.amp/portals/

# typescript
*.tsbuildinfo
next-env.d.ts
